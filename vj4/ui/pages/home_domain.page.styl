.page--home_domain
  .col--icon
    width: 60px
    line-height: 1

    img
      border-radius: 50%

  .col--role
    width: rem(160px)
    border-left: 1px solid $table-border-color

  .col--action
    width: rem(160px)
    border-left: 1px solid $table-border-color

  +mobile()
    .col--icon, .col--role
      display: none

.pin
  border: 0
  background: none
  outline: 0
  padding: 0
  margin: 0

  .pined--show
    display: none
  .pined--hide
    display: block

  &.activated
    .pined--show
      display: block
    .pined--hide
      display: none

.pinlogo
  border: 0
  background: none
  padding: 0
  margin: 0
  display: none

  &.show
    display: inline
    -webkit-border-radius: 6px
    border-radius: 6px
    background-color:#f03e3e
    padding: 0px 3px
    margin-right: 3px
    color:white
      

